# =============================================================================
# Portfolio 2.0 — environment variables
# =============================================================================
# Copy this file to `.env.local` and fill in real values.
# `.env.local` is gitignored and must NEVER be committed.
#
# Variables prefixed `NEXT_PUBLIC_` are inlined into the client bundle at build
# time, so changes require a rebuild to take effect on the browser.
# =============================================================================


# -----------------------------------------------------------------------------
# AI — Groq SDK (powers the Chitti chatbot + architecture explanations)
# -----------------------------------------------------------------------------
# Generate a key at: https://console.groq.com/keys
# When unset, every AI route gracefully falls back to a streaming offline
# message — so the site still works locally without a key (recommended for
# first-time setup).
GROQ_API_KEY=


# -----------------------------------------------------------------------------
# Public site configuration
# -----------------------------------------------------------------------------

# Canonical site URL — used by metadata, sitemap, robots.txt, JSON-LD.
# Override in deploy previews so OG + canonical URLs point at the preview.
NEXT_PUBLIC_SITE_URL=https://me.toinfinite.dev

# Build-time "Last deployed" stamp on the footer. ISO date string.
# Optional — falls back to `new Date().toISOString()` at build time.
NEXT_PUBLIC_LAST_DEPLOYED=


# -----------------------------------------------------------------------------
# Analytics (all optional — leave blank to disable)
# -----------------------------------------------------------------------------

# Google Analytics 4 measurement ID, e.g. G-XXXXXXX
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Hotjar site ID, e.g. 1234567
NEXT_PUBLIC_HOTJAR_ID=


# -----------------------------------------------------------------------------
# Optional integrations
# -----------------------------------------------------------------------------

# LeetCode username. When set, the Trust & Proof section links to the
# profile and shows the live card. When blank, a privacy-friendly
# placeholder is shown.
NEXT_PUBLIC_LEETCODE_USERNAME=

# Calendly URL (e.g. https://calendly.com/dhinesh/intro). When set, the
# Footer renders a "Schedule a call" CTA. When blank, the CTA is hidden
# (no broken link).
NEXT_PUBLIC_CALENDLY_URL=

# Production flag. When "1", the client surfaces a build badge in the
# console (and any other production-only UI).
NEXT_PUBLIC_PRODUCTION=