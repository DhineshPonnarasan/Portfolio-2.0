# Environment variables for the Portfolio 2.0 site.
# Copy this file to `.env.local` and fill in real values.
# `.env.local` is gitignored and must NEVER be committed.

# Required for all AI features (Chitti chatbot, architecture explanations,
# architecture voice, architecture compare, architecture simulate,
# architecture challenge, architecture explain).
# When unset, every AI route gracefully falls back to a streaming offline
# message — so the site still works locally without a key.
#
# Generate at: https://console.groq.com/keys
GROQ_API_KEY=

# Optional: Google Analytics measurement ID.
# Leave blank to disable analytics.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Optional: Hotjar site ID.
# Leave blank to disable Hotjar.
NEXT_PUBLIC_HOTJAR_ID=

# Optional: Canonical site URL (used by metadata, sitemap, and JSON-LD).
# Defaults to https://me.toinfinite.dev.
NEXT_PUBLIC_SITE_URL=

# Optional: LeetCode username. When set, the Trust & Proof section will
# render the user's profile link. When unset, a privacy-friendly placeholder
# is shown instead.
NEXT_PUBLIC_LEETCODE_USERNAME=

# Optional: Calendly URL. When set, the Footer renders a 'Schedule a call'
# CTA. When unset, the CTA is hidden (no broken link).
NEXT_PUBLIC_CALENDLY_URL=
